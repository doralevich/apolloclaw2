# Get it from https://www.agent37.com/dashboard/cloud/api-keys
AGENT37_API_KEY=
# AGENT37_API_BASE_URL defaults to https://api.agent37.com — uncomment to override
# Apex domain for per-instance Agents API hosts (https://{id}.<domain>) — defaults to agent37.app
# AGENT37_INSTANCE_DOMAIN=agent37.app

# One Tavily API key for the whole fleet — enables web search on every provisioned instance
# (lib/instance-defaults.ts). Get it from https://app.tavily.com. Unset = agents come up without
# web search (memory + clock still apply).
TAVILY_API_KEY=

# One OpenAI API key for the whole fleet — lets instances run OpenAI (GPT) chat models alongside
# Anthropic, so the chat model switcher can offer both. Set in the Vercel deploy env only, never
# committed. The provider is registered on each instance by mirroring how Anthropic is wired
# (read a known-good box with the admin config-inspect route first); GPT usage bills to this key.
OPENAI_API_KEY=

# Master switch for the openclaw.json capability writes (memory embeddings + Tavily search) in
# lib/instance-defaults.ts. OFF by default: the exact config keys were taken from docs, and a
# wrong one took a customer instance's agent runtime down ("openclaw harness is not available").
# The clock step still runs when this is off. Set to "on" ONLY after the keys are verified
# against a live, known-good instance (use the admin Revert defaults route's ?inspect=1).
INSTANCE_DEFAULTS_CONFIG=

# Supabase CLI auth token (not read by the app) — https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=

# --- Supabase: dashboard project ---
# DASHBOARD_SUPABASE_REF + _DB_PASSWORD are for the `supabase` CLI (link / db push), not the app.
DASHBOARD_SUPABASE_REF=
DASHBOARD_SUPABASE_DB_PASSWORD=
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_APP_NAME=

# Channels ("Chat anywhere" — WhatsApp/Telegram/Slack/Discord). Set to "true" only once the
# channel endpoints in lib/agent37.ts are confirmed against the live Agent37 API; until then
# the tab and the page are absent rather than present and failing.
NEXT_PUBLIC_CHANNELS_ENABLED=

# --- Supabase: CRM "Brain" project (separate from the dashboard project above) ---
# Lead-capture routes (intake, contact, pre-call) write the CRM cards to a DIFFERENT
# Supabase project than the app's own DB. The dashboard's SUPABASE_SERVICE_ROLE_KEY belongs
# to the dashboard project, so reusing it for CRM writes authenticates against the wrong
# project and every write silently no-ops (emails still send). Set these to the CRM/Brain
# project's own URL + service_role key. If unset, the code falls back to SUPABASE_URL /
# SUPABASE_SERVICE_ROLE_KEY (which is why CRM writes fail once the dashboard key is in place).
CRM_SUPABASE_URL=https://moubzvpffhqvumipbnfj.supabase.co
CRM_SUPABASE_SERVICE_KEY=

# --- Stripe (agent storefront: $4,500 build + $189/mo hosting bundles) ---
# Secret key. Use sk_test_... first; switch to sk_live_... only after verifying the full
# buy -> provision flow. Never commit or hardcode this.
STRIPE_SECRET_KEY=
# Signing secret of THIS deployment's webhook endpoint (Stripe dashboard -> Webhooks ->
# endpoint for <site>/api/stripe/webhook). Test and live endpoints have different secrets.
STRIPE_WEBHOOK_SECRET=

# Chat widget
# Required for /api/chat. Get this from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional lightweight shared token checked by /api/chat when set.
# This is app-defined, not issued by a provider. Generate any long random string
# and make sure the chat client sends the same value in `_token`.
CHAT_API_TOKEN=

# Optional: enables Telegram notifications for new chats/leads
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Mandrill (transactional email) — powers intake PDFs and storefront notifications
# (agent purchased + agent-setup PDF). Without it, those emails are skipped (Telegram still fires).
# Mailchimp MARKETING API key — adds newsletter signups to the Weekly Claw audience
# (app/api/subscribe/route.ts). This is NOT the Mandrill key below: Mandrill is Mailchimp
# Transactional and cannot touch audiences. Get this one from Mailchimp -> profile ->
# Extras -> API keys. It ends in a datacenter suffix like "-us1", which the subscribe route
# parses out to build the API host, so a key without that suffix will not work.
# Without it, /api/subscribe returns "Service unavailable".
MAILCHIMP_API_KEY=

# Mandrill (Mailchimp Transactional) — sends one-off email: intake PDFs, contact
# notifications, sale alerts. Different product, different key, different dashboard.
MANDRILL_API_KEY=
# Where storefront/internal notifications are emailed; defaults to david@apolloclaw.ai.
NOTIFY_EMAIL=

# Pam Fox / Taylor Hamilton Zoom integration
# Add real values in Vercel Project Settings → Environment Variables.
# Do not use fake placeholder values in production.
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_REDIRECT_URI=https://www.apolloclaw.ai/pam/zoom/callback
ZOOM_WEBHOOK_SECRET_TOKEN=
ZOOM_STORAGE_BUCKET=zoom-integrations
# Required to access /pam/zoom/status. Use a long random string in Vercel.
ZOOM_STATUS_TOKEN=

# AES-256-GCM key for encrypting customer-supplied credentials at rest
# (the Anthropic / Telegram / Fireflies / Tavily secrets collected by /setup).
# Generate with: openssl rand -base64 48
# Until this is set, those credentials are stored as plaintext and a warning is logged.
BYO_ENC_KEY=
