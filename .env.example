# Get it from https://www.agent37.com/dashboard/cloud/api-keys
AGENT37_API_KEY=
# AGENT37_API_BASE_URL defaults to https://api.agent37.com — uncomment to override

# Supabase CLI auth token (not read by the app) — https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=

# --- Supabase: dashboard project ---
# DASHBOARD_SUPABASE_REF + _DB_PASSWORD are for the `supabase` CLI (link / db push), not the app.
DASHBOARD_SUPABASE_REF=
DASHBOARD_SUPABASE_DB_PASSWORD=
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_APP_NAME=
